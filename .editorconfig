# Shared formatting rules.
#
# ktlint (via detekt-formatting) reads this file directly, and Android Studio honours it too.
# That is the point: the IDE formats code to the same rules CI enforces, so violations are
# fixed as you type rather than discovered on a failed build.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120

# Kotlin supports trailing commas; ktlint does not enforce them by default. They keep diffs
# to one line when a parameter is added, instead of two.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Compose functions are PascalCase by convention. detekt's FunctionNaming rule excludes
# @Composable for the same reason.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing whitespace is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.xml]
indent_size = 4
