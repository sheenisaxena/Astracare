<?xml version="1.0" encoding="utf-8"?><!--
  Android 12+ backup and device-to-device transfer.

  `android:allowBackup="false"` covers cloud backup on its own. This file is still filled in
  rather than left as the template's commented-out sample, because device-to-device transfer
  is a SEPARATE channel that allowBackup does not govern: a phone-to-phone migration would
  otherwise carry the whole database across.

  Both channels are refused. The records here have not necessarily reached a server yet, and
  a copy of them arriving on a device this app has never run on is a copy nobody is tracking.
  The Keystore-wrapped passphrase would not travel with it either, so the copy would be
  unreadable — unwanted first, useless second.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
